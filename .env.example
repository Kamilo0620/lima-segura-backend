# ============================================================================
# Plantilla de configuracion (.env.example) - Sin credenciales reales
# Copiar a .env y colocar tu API key local (el archivo .env NO se sube a Git)
# ============================================================================
INGESTION_ENABLED=true
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=tu_api_key
LLM_MODEL=gemini-3.8-flash
# Opcional: modelos de respaldo si el principal falla (separados por coma)
LLM_MODELS=
